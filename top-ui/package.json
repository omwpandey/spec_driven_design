{
  "name": "tops-crm-framework",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "format": "prettier --write \"src/**/*.{ts,tsx,json,css}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "node -e \"require('fs').rmSync('coverage',{recursive:true,force:true})\" && vitest run --coverage",
    "test:coverage:ci": "node -e \"require('fs').rmSync('coverage',{recursive:true,force:true})\" && vitest run --coverage --exclude=src/app/store/__tests__/appSlice.test.ts --exclude=src/app/store/__tests__/configSlice.test.ts --exclude=src/core/api/__tests__/apiService.test.ts --exclude=src/core/languages/__tests__/translate.test.ts --exclude=src/core/manifest/__tests__/fieldRendererRegistry.test.ts --exclude=src/core/manifest/__tests__/moduleRegistry.test.ts",
    "test:dom": "vitest run src/components --environment jsdom",
    "test:profile:imports": "vitest run --experimental.importDurations.print",
    "mock:server": "json-server --watch src/mocks/db.json --port 3001"
  },
  "dependencies": {
    "@azure/msal-browser": "^5.21.0",
    "@azure/msal-react": "^5.7.0",
    "@emotion/react": "^11.13.0",
    "@emotion/styled": "^11.13.0",
    "@hookform/resolvers": "^3.9.0",
    "@mui/icons-material": "^9.4.0",
    "@mui/material": "^9.3.1",
    "@reduxjs/toolkit": "^2.6.0",
    "axios": "^1.7.0",
    "dayjs": "^1.11.13",
    "echarts": "6.1.0",
    "lodash": "^4.17.21",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.54.0",
    "react-redux": "^9.2.0",
    "react-router-dom": "^7.6.0",
    "yup": "^1.6.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.0",
    "@types/lodash": "^4.17.0",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.3.0",
    "@vitest/coverage-v8": "^4.0.0",
    "@vitest/ui": "^4.0.0",
    "eslint": "^9.0.0",
    "happy-dom": "^20.11.2",
    "jsdom": "^30.0.1",
    "json-server": "^1.0.0-beta.3",
    "msw": "^2.7.0",
    "prettier": "^3.4.0",
    "typescript": "~7.0.2",
    "vite": "^6.0.0",
    "vitest": "^4.1.11"
  }
}
